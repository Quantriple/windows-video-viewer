#pragma code_page(65001)  // UTF-8 代码页
#include "resource.h"
#include <windows.h>

// 主菜单
IDR_MAIN_MENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "扫描目录(&S)\tCtrl+S",        ID_FILE_SCAN
        MENUITEM "刷新列表(&R)\tF5",           ID_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)\tAlt+F4",           ID_FILE_EXIT
    END
    POPUP "查看(&V)"
    BEGIN
        MENUITEM "列表视图(&L)",               ID_VIEW_LIST
        MENUITEM "详细信息(&D)",               ID_VIEW_DETAILS
        MENUITEM SEPARATOR
        MENUITEM "显示缩略图(&T)",             ID_VIEW_THUMBNAILS
    END
    POPUP "工具(&T)"
    BEGIN
        MENUITEM "搜索(&S)\tCtrl+F",           ID_TOOLS_SEARCH
        MENUITEM "设置(&O)\tCtrl+,",           ID_TOOLS_SETTINGS
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "关于(&A)",                   ID_HELP_ABOUT
    END
END

// 快捷键
IDR_ACCELERATOR ACCELERATORS
BEGIN
    "S",            ID_FILE_SCAN,           VIRTKEY, CONTROL
    VK_F5,          ID_FILE_REFRESH,        VIRTKEY
    "F",            ID_TOOLS_SEARCH,        VIRTKEY, CONTROL
    ",",            ID_TOOLS_SETTINGS,      VIRTKEY, CONTROL
    VK_F4,          ID_FILE_EXIT,           VIRTKEY, ALT
END

// 搜索对话框
IDD_SEARCH DIALOG 0, 0, 350, 250
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "搜索视频文件"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "关键词:", IDC_STATIC, 10, 15, 60, 12
    EDITTEXT        IDC_SEARCH_TEXT, 75, 12, 180, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "搜索", IDC_SEARCH_BUTTON, 265, 12, 50, 14
    PUSHBUTTON      "清除", IDC_CLEAR_SEARCH, 265, 32, 50, 14
    
    LTEXT           "搜索结果:", IDC_STATIC, 10, 40, 60, 12
    LISTBOX         IDC_SEARCH_RESULTS, 10, 55, 330, 160, LBS_NOTIFY | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    
    DEFPUSHBUTTON   "确定", IDOK, 240, 225, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 295, 225, 50, 14
END

// 设置对话框
IDD_SETTINGS DIALOG 0, 0, 420, 350
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    GROUPBOX        "扫描路径", IDC_STATIC, 10, 10, 400, 120
    LISTBOX         IDC_SCAN_PATHS, 20, 25, 300, 80, LBS_NOTIFY | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "添加路径", IDC_ADD_PATH, 330, 25, 70, 20
    PUSHBUTTON      "删除路径", IDC_REMOVE_PATH, 330, 50, 70, 20
    CONTROL         "自动刷新", IDC_AUTO_REFRESH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 110, 60, 12
    
    GROUPBOX        "播放器设置", IDC_STATIC, 10, 140, 400, 80
    LTEXT           "播放器路径:", IDC_STATIC, 20, 160, 60, 12
    EDITTEXT        IDC_PLAYER_PATH, 85, 157, 240, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "浏览", IDC_BROWSE_PLAYER, 330, 157, 70, 14
    CONTROL         "使用默认播放器", IDC_USE_DEFAULT_PLAYER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 180, 120, 12
    CONTROL         "显示缩略图", IDC_SHOW_THUMBNAILS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 200, 80, 12
    
    GROUPBOX        "排序设置", IDC_STATIC, 10, 230, 400, 60
    LTEXT           "排序方式:", IDC_STATIC, 20, 250, 60, 12
    COMBOBOX        IDC_SORT_BY, 85, 247, 100, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "升序", IDC_SORT_ASCENDING, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 200, 250, 40, 12
    CONTROL         "降序", IDC_SORT_DESCENDING, "Button", BS_AUTORADIOBUTTON, 250, 250, 40, 12
    
    LTEXT           "缓存路径:", IDC_STATIC, 20, 270, 60, 12
    EDITTEXT        IDC_CACHE_PATH, 85, 267, 240, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "浏览", IDC_BROWSE_CACHE, 330, 267, 70, 14
    
    DEFPUSHBUTTON   "确定", IDOK, 250, 320, 50, 20
    PUSHBUTTON      "取消", IDCANCEL, 310, 320, 50, 20
    PUSHBUTTON      "应用", IDAPPLY, 370, 320, 40, 20
END